"notifications.daily.6.body" = "%@ இல் சிறு இடைவேளை: இன்றிலிருந்து எடுத்துக்கொள்ள விரும்பும் %d விஷயங்களை குறிப்பிடு.";
"notifications.daily.6.title" = "ஒரு கடைசி விஷயம்";
"notifications.daily.7.body" = "%@ அருகில்: உன் நாளிலிருந்து %d விஷயங்களை சேமிக்கும் நேரம்.";
"notifications.daily.7.title" = "எழுது";
"notifications.daily.8.body" = "%@ ping: இன்று உன்னை சிரிக்க வைத்த %d விஷயங்களை எழுது.";
"notifications.daily.8.title" = "ஹா ஹா";
"notifications.daily.9.body" = "%@: இன்று நீ பெருமைப்படும் %d விஷயங்களை எழுது.";
"notifications.daily.9.title" = "பெருமை தருணம்";
"notifications.daily.10.body" = "%@ அருகில்: இன்று நீ செய்த %d வேடிக்கையான விஷயங்களை குறிப்பிடு.";
"notifications.daily.10.title" = "கிட்டத்தட்ட முடிந்தது!";
"notifications.next.1.body" = "%@ ping: நேற்றைய உள்ளீட்டில் %d விஷயங்களை சேர்க்கவும்.";
"notifications.next.1.title" = "காலை சோதனை";
"notifications.next.2.body" = "%@ ஆகிவிட்டது: நேற்றை விரைவாக பார்த்து %d விஷயங்களை எழுது.";
"notifications.next.2.title" = "பின்னோக்கி பார்";
"notifications.next.3.body" = "%@ இல்: நேற்று நன்றாக நடந்த %d விஷயங்களை குறிப்பிடு.";
"notifications.next.3.title" = "நேர்மறை தொடக்கம்";
"notifications.next.4.body" = "%@ நினைவூட்டல்: நேற்றை %d குறுகிய குறிப்புகளுடன் முடி.";
"notifications.next.4.title" = "முடி";
"notifications.next.5.body" = "காலை வணக்கம், %@! நேற்று உன்னை மகிழ்ச்சியடையச் செய்த %d விஷயங்களை குறிப்பிடு.";
"notifications.next.5.title" = "நன்றாக உணரு";
"notifications.next.6.body" = "%@: நேற்றைய உன் பக்கம் இன்னும் காலியாக உள்ளது, %d விஷயங்களை சேர்க்கவும்.";
"notifications.next.6.title" = "காலியான பக்கம்";
"notifications.next.7.body" = "%@ நினைவூட்டல்: உன் தொடர்ச்சியை தொடர %d விஷயங்களை நேற்று பற்றி எழுது.";
"notifications.next.7.title" = "தொடர்ச்சியை பேணு";
"notifications.next.8.body" = "காலை வணக்கம்! %@: நேற்றைய விரைவு சுருக்கம் %d புள்ளிகளில்.";
"notifications.next.8.title" = "விரைவு சுருக்கம்";
"notifications.next.9.body" = "%@: நேற்று பற்றி %d விஷயங்களை எழுது, நினைவில் வைத்திருக்க வேண்டாம்.";
"notifications.next.9.title" = "தலையிலிருந்து வெளியே";
"notifications.next.10.body" = "%@ ஆகிவிட்டது: நேற்றைய உள்ளீட்டை %d விஷயங்களுடன் முடி.";
"notifications.next.10.title" = "முடி";
