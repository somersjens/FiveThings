"access.card.1" = "Številne študije kažejo, da vsakodnevno zapisovanje *petih lepih stvari*, za katere si hvaležen, krepi občutek sreče in spodbuja bolj pozitivno razmišljanje.";
"access.card.2" = "V študiji s *stotimi* udeleženci so tisti, ki so vztrajali pri tej navadi, dosegli *za 12 % višje* rezultate na lestvici dobrega počutja v primerjavi s kontrolno skupino.\n\n |Emmons & McCullough, 2003|";
"access.card.3" = "Ta metoda je omenjena tudi v tečaju *Univerze Yale* »|The Science of Well-Being|« kot ena od šestih *enostavnih vaj*, ki močno prispevajo k boljšemu počutju.";
"access.card.4" = "Celoten seznam:\n\n• 30 minut lahkega gibanja\n• 10 minut meditacije\n• *Zapiši pet lepih stvari*\n• 1 minuta zavestnega uživanja\n• 1 nova socialna interakcija\n• 1 dobro dejanje";
"access.card.5" = "Ta aplikacija spoštuje tvojo *zasebnost* in ohranja vse preprosto. Brez premium možnosti; simbolični prispevek *5 €* (ali ekvivalent v tvoji valuti) za podporo razvoju je popolnoma *prostovoljen*.";
