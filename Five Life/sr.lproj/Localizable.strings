"access.card.1" = "Brojna istraživanja pokazuju da *svakodnevno* zapisivanje *pet dobrih stvari*, za koje si zahvalan, jača osećaj sreće i podstiče pozitivnije razmišljanje.";
"access.card.2" = "U studiji sa *stotinama* učesnika, oni koji su praktikovali ovu naviku postigli su *za 12% više* na skali blagostanja (mereno preko celog opsega) u odnosu na kontrolnu grupu.\n\n |Emmons & McCullough, 2003|";
"access.card.3" = "Ovaj metod se takođe pominje u kursu *Univerziteta Jejla* „|The Science of Well-Being|“ kao jedan od šest *jednostavnih vežbi* koje značajno doprinose većoj sreći.";
"access.card.4" = "Kompletna lista:\n\n• 30 minuta laganog kretanja\n• 10 minuta meditacije\n• *Zapiši pet dobrih stvari*\n• 1 minuta svesnog uživanja\n• 1 nova socijalna interakcija\n• 1 dobar postupak";
"access.card.5" = "Ova aplikacija poštuje tvoju *privatnost* i drži sve jednostavnim. Nema premium opcija; simbolički doprinos *5 €* (ili ekvivalent u tvojoj valuti) za podršku razvoju je potpuno *opcioni*.";
