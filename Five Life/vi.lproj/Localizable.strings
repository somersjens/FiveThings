"access.card.1" = "Nhiều nghiên cứu cho thấy việc *hàng ngày* ghi lại *năm điều tốt* mà bạn biết ơn có thể tăng cường cảm giác hạnh phúc và thúc đẩy tư duy tích cực hơn.";
"access.card.2" = "Trong một nghiên cứu với *hàng trăm* người tham gia, những người thực hiện thói quen này đạt điểm hạnh phúc *cao hơn 12%* (trên toàn thang đo) so với nhóm đối chứng. \n\n |Emmons & McCullough, 2003|";
"access.card.3" = "Phương pháp này cũng được đề cập trong khóa học của *Đại học Yale* “|The Science of Well-Being|” như một trong sáu *bài tập dễ thực hiện* giúp cải thiện đáng kể hạnh phúc.";
"access.card.4" = "Danh sách đầy đủ:\n\n• 30 phút vận động nhẹ\n• 10 phút thiền\n• *Ghi lại năm điều tốt*\n• 1 phút tận hưởng có ý thức\n• 1 tương tác xã hội mới\n• 1 hành động tử tế";
"access.card.5" = "Ứng dụng này tôn trọng *quyền riêng tư* của bạn và giữ mọi thứ đơn giản. Không có tùy chọn trả phí; đóng góp tượng trưng *5 €* (hoặc tương đương địa phương) để hỗ trợ phát triển là hoàn toàn *tùy chọn*.";
