"access.card.1" = "Brojna istraživanja pokazuju da *svakodnevno* zapisivanje *pet lijepih stvari*, za koje si zahvalan, jača osjećaj sreće i potiče pozitivnije razmišljanje.";
"access.card.2" = "U istraživanju s *stotinama* sudionika, oni koji su prakticirali ovu naviku postigli su *za 12 % više* na skali blagostanja (mjereno preko cijelog raspona) u usporedbi s kontrolnom grupom.\n\n |Emmons & McCullough, 2003|";
"access.card.3" = "Ovaj način također se spominje u tečaju *Sveučilišta Yale* „|The Science of Well-Being|“ kao jedna od šest *jednostavnih vježbi* koje značajno pridonose većoj sreći.";
"access.card.4" = "Potpuni popis:\n\n• 30 minuta laganog kretanja\n• 10 minuta meditacije\n• *Zapiši pet lijepih stvari*\n• 1 minuta svjesnog uživanja\n• 1 nova socijalna interakcija\n• 1 dobro djelo";
"access.card.5" = "Ova aplikacija poštuje tvoju *privatnost* i sve drži jednostavnim. Nema premium opcija; simboličan doprinos *5 €* (ili ekvivalent u tvojoj valuti) za podršku razvoju potpuno je *dobrovoljan*.";
